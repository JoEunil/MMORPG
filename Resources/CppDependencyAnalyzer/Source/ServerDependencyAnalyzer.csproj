<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Report.html;RelationshipLayout.js;Report.js" />
    <Content Include="obj/clang/libclang.dll;obj/clang/LLVM-LICENSE.txt;obj/clang/resources/**/*"
             Condition="Exists('obj/clang/libclang.dll')" Exclude="obj/clang/resources/include/Headers/**/*">
      <Link>clang/$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/obj/clang', '%(FullPath)'))</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyAnalyzerToToolDirectory" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <AnalyzerRuntimeFiles Include="$(TargetDir)**/*" Exclude="$(TargetDir)**/*.pdb;$(TargetDir)Reports/**/*;$(TargetDir)report.html" />
    </ItemGroup>
    <Copy SourceFiles="@(AnalyzerRuntimeFiles)"
          DestinationFiles="@(AnalyzerRuntimeFiles->'$(MSBuildProjectDirectory)/../%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../Reports/server-project-map.html"
          DestinationFiles="$(MSBuildProjectDirectory)/../report.html"
          Condition="!Exists('$(MSBuildProjectDirectory)/../report.html')" />
  </Target>
</Project>
